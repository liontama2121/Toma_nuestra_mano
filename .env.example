# =====================================================================
# CLOUDFLARE PAGES — Compatibility flags requeridos
#   - Production:  nodejs_compat
#   - Preview:     nodejs_compat
# Configurar en: Pages → Settings → Functions → Compatibility flags
#
# Build:
#   - Build command:           npm run pages:build
#   - Build output directory:  .vercel/output/static
#   - Node version (env var):  NODE_VERSION = 20
# =====================================================================

# ─────────────────────────────────────────────────────────────
# Keycloak — Autenticación de la plataforma educativa
# Copia este archivo a .env.local y completa los valores reales
# ─────────────────────────────────────────────────────────────

# URL base del servidor Keycloak (sin barra final)
# Ejemplo: https://auth.tudominio.com
NEXT_PUBLIC_KEYCLOAK_URL=https://your-keycloak-server.com

# Nombre del realm configurado en Keycloak
NEXT_PUBLIC_KEYCLOAK_REALM=toma-nuestra-mano

# Client ID registrado en el realm (tipo: public, con PKCE)
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=plataforma-estudiante

# URL pública de la aplicación (para construir redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# MODO DESARROLLO
# Si NEXT_PUBLIC_KEYCLOAK_URL está vacío, la plataforma usa
# autenticación simulada con el estudiante de prueba.
# ─────────────────────────────────────────────────────────────
